# lombok.config
# Prevent Lombok from looking in parent directories for additional config
config.stopBubbling = true

# ── Copyable annotations ──────────────────────────────────────────────────────
# These annotations are copied from fields onto the generated constructor
# parameters, allowing Spring to resolve them correctly at injection time.

lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Autowired
lombok.copyableAnnotations += jakarta.annotation.Nonnull
lombok.copyableAnnotations += org.springframework.lang.NonNull
lombok.copyableAnnotations += org.springframework.lang.Nullable